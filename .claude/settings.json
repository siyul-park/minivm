{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f && [[ \"$f\" == *.go ]] && ~/go/bin/goimports -w \"$f\"; } 2>/dev/null || true",
            "statusMessage": "goimports...",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "lighthouse hook claude-code post-tool-use --allow-incomplete",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "lighthouse hook claude-code pre-tool-use",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "lighthouse hook claude-code session-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "lighthouse hook claude-code stop --allow-incomplete",
            "timeout": 300,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "lighthouse hook claude-code user-prompt-submit",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go generate *)",
      "Bash(go mod *)",
      "Bash(go run *)",
      "Bash(goimports *)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make coverage*)",
      "Bash(make benchmark*)",
      "Bash(make fmt*)",
      "Bash(make vet*)",
      "Bash(make build*)",
      "Bash(make tidy*)",
      "Bash(make doc*)",
      "Bash(grep *)",
      "Bash(find . *)"
    ],
    "deny": [
      "Bash(lighthouse trust:*)"
    ]
  }
}
