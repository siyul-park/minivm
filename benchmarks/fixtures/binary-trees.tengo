node := func(item, left, right) {
    return [item, left, right]
}

build := func(item, depth) {
    if depth > 0 {
        return node(
            item,
            build(2*item-1, depth-1),
            build(2*item, depth-1)
        )
    }
    return node(item, undefined, undefined)
}

check := func(tree) {
    if tree[1] == undefined {
        return tree[0]
    }
    return tree[0] + check(tree[1]) - check(tree[2])
}

minDepth := 4
maxDepth := 6
result := check(build(0, maxDepth+1))
longLived := build(0, maxDepth)

for depth := minDepth; depth <= maxDepth; depth += 2 {
    iterations := 1
    for shift := 0; shift < maxDepth-depth+minDepth; shift++ {
        iterations *= 2
    }

    total := 0
    for i := 1; i <= iterations; i++ {
        total += check(build(i, depth))
        total += check(build(-i, depth))
    }
    result += total
}

result += check(longLived)
