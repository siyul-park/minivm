escape := func(cr, ci, maxIter) {
    zr := 0.0
    zi := 0.0
    for i := 0; i < maxIter; i = i + 1 {
        zr2 := zr * zr
        zi2 := zi * zi
        if zr2 + zi2 > 4.0 {
            return i
        }
        nextZR := zr2 - zi2 + cr
        nextZI := 2.0 * zr * zi + ci
        zr = nextZR
        zi = nextZI
    }
    return maxIter
}

result := 0
for py := 0; py < 16; py = py + 1 {
    cy := -1.5 + 3.0 * float(py) / 15.0
    for px := 0; px < 16; px = px + 1 {
        cx := -2.0 + 3.0 * float(px) / 15.0
        result += escape(cx, cy, 50)
    }
}
