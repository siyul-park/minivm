result := func() {
    composite := []
    for index := 0; index < 256; index++ {
        composite = append(composite, 0)
    }

    for value := 2; value * value < 256; value++ {
        for multiple := value * value; multiple < 256; multiple += value {
            composite[multiple] = 1
        }
    }

    count := 0
    for value := 2; value < 256; value++ {
        if composite[value] == 0 {
            count++
        }
    }

    return count
}()
